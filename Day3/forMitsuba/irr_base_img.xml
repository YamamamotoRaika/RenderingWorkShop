  <medium type="homogeneous" id="skin_medium">
    <rgb name="albedo" value="0.95, 0.85, 0.75"/>
    <float name="sigma_t" value="50.0"/>
    <phase type="hg">
      <float name="g" value="0.0"/>
    </phase>
  </medium>

  <!-- 蠅・阜縺ｯ null・嗄edium 縺ｸ縺ｮ蜈･蜃ｺ繧帝が鬲斐＠縺ｪ縺・-->
  <bsdf type="null" id="skin_boundary"/>

  <bsdf type="diffuse" id="black">
    <rgb name="reflectance" value="0,0,0"/>
  </bsdf>

  
  <!-- Skin slab -->
  <shape type="cube" id="skin">
    <transform name="to_world">
      <scale x="5.0" y="0.1" z="5.0"/>
      <translate x="0" y="0.0" z="0"/>
    </transform>

    <ref id="skin_boundary"/>

    <!-- 笘・％繧後′豁｣隗｣・嘖hape 縺ｫ medium 繧貞牡繧雁ｽ薙※繧・-->
